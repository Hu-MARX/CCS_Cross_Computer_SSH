{
  "$ref": "#/$defs/experimentSpec",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "experimentSpec": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "project": {
          "anyOf": [
            {
              "type": "object",
              "properties": {},
              "required": [],
              "additionalProperties": true
            },
            {
              "type": "null"
            }
          ]
        },
        "runtime": {
          "anyOf": [
            {
              "type": "object",
              "properties": {},
              "required": [],
              "additionalProperties": true
            },
            {
              "type": "null"
            }
          ]
        },
        "command": {
          "type": "object",
          "properties": {
            "argv": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "shell": {
              "const": false
            }
          },
          "required": [
            "argv"
          ],
          "additionalProperties": true
        },
        "resources": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "gpu_index": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "max_duration_seconds": {
                  "anyOf": [
                    {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "max_queue_seconds": {
                  "anyOf": [
                    {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [],
              "additionalProperties": true
            },
            {
              "type": "null"
            }
          ]
        },
        "outputs": {
          "anyOf": [
            {
              "type": "object",
              "properties": {},
              "required": [],
              "additionalProperties": true
            },
            {
              "type": "null"
            }
          ]
        },
        "evaluation": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "argv": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [],
              "additionalProperties": true
            },
            {
              "type": "null"
            }
          ]
        },
        "success": {
          "anyOf": [
            {
              "type": "object",
              "properties": {},
              "required": [],
              "additionalProperties": true
            },
            {
              "type": "null"
            }
          ]
        },
        "automation": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "max_attempts": {
                  "type": "integer",
                  "minimum": 1
                },
                "allowed_actions": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "wait",
                      "evaluate",
                      "retry_same",
                      "resume_checkpoint",
                      "run_test",
                      "request_approval",
                      "complete",
                      "stop_workflow"
                    ]
                  }
                }
              },
              "required": [],
              "additionalProperties": true
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "bundle_id": {
                  "type": "string",
                  "pattern": "^bundle_[a-f0-9]{32}$"
                },
                "manifest_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "timeout_seconds": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3600,
                  "default": 600
                },
                "execution_mode": {
                  "enum": [
                    "source",
                    "snapshot"
                  ],
                  "default": "source"
                }
              },
              "required": [
                "bundle_id",
                "manifest_sha256"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "task": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "train",
                    "test",
                    "analysis",
                    "build",
                    "simulate",
                    "benchmark",
                    "data"
                  ]
                },
                "source_run_id": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "inputs": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/inputReference"
                  },
                  "maxItems": 64
                },
                "pause": {
                  "type": "object",
                  "properties": {
                    "schema_version": {
                      "const": 1
                    },
                    "protocol": {
                      "const": "managed-checkpoint-v1"
                    },
                    "contract": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  },
                  "required": [
                    "schema_version",
                    "protocol",
                    "contract"
                  ],
                  "additionalProperties": false
                },
                "checkpoint": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/inputReference"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "kind"
              ],
              "allOf": [
                {
                  "if": {
                    "required": [
                      "pause"
                    ]
                  },
                  "then": {
                    "properties": {
                      "kind": {
                        "const": "train"
                      }
                    }
                  }
                }
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "name",
        "command"
      ],
      "additionalProperties": true,
      "description": "Known execution fields are validated; metadata objects remain extensible. Null optional metadata objects normalize to empty objects. Unknown top-level metadata is retained by the contract but may be ignored by ExperimentSpec normalization."
    },
    "inputReference": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    }
  }
}
