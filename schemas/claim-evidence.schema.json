{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/claim-evidence.schema.json",
  "title": "Claim Evidence Ledger v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "study_id", "claims"],
  "properties": {
    "schema_version": {"const": 1},
    "study_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "boundary", "status", "evidence", "limitations"],
        "properties": {
          "id": {"type": "string", "pattern": "^claim-[a-z0-9][a-z0-9_-]{0,63}$"},
          "text": {"type": "string", "minLength": 1},
          "boundary": {"type": "string", "minLength": 1},
          "status": {"enum": ["planned", "supported", "refuted", "inconclusive"]},
          "evidence": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256", "role"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
                "role": {"enum": ["primary", "supporting", "limitation"]}
              }
            }
          },
          "limitations": {
            "type": "array",
            "maxItems": 32,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
