{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/recommendation.schema.json",
  "title": "Recommendation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "idempotency_key", "stage_id", "plan_sha256", "proposer",
    "decision", "summary", "rationale", "confidence", "skills_used", "evidence", "limitations"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "idempotency_key": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "stage_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact_bindings_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "proposer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "kind": {"enum": ["agent", "human", "pipeline"]}
      }
    },
    "decision": {"enum": ["PROCEED", "WAIT", "STOP"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
    "rationale": {"type": "string", "minLength": 1, "maxLength": 4000},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "skills_used": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}
    },
    "evidence": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["run_id", "result_sha256", "observed_at", "observation_state"],
        "properties": {
          "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
          "result_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "observed_at": {"type": "string", "format": "date-time"},
          "observation_state": {"enum": ["fresh", "stale"]}
        }
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"decision": {"const": "PROCEED"}}, "required": ["decision"]},
      "then": {
        "properties": {
          "skills_used": {"minItems": 1},
          "evidence": {"minItems": 1}
        }
      }
    }
  ]
}
