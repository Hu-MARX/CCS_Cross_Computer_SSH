{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/study-spec.schema.json",
  "title": "StudySpec v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "research_question", "stages"],
  "properties": {
    "schema_version": {"const": 1},
    "name": {"type": "string", "minLength": 1, "maxLength": 200},
    "research_question": {"type": "string", "minLength": 1, "maxLength": 4000},
    "planning": {"type": "object"},
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_runs": {"type": "integer", "minimum": 1, "maximum": 1024}
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "kind", "spec"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
          "name": {"type": "string", "minLength": 1, "maxLength": 200},
          "kind": {
            "enum": ["analysis", "benchmark", "build", "data", "simulate", "test", "train"]
          },
          "spec": {"$ref": "experiment-spec.schema.json"},
          "depends_on": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}
          },
          "requires_approval": {"type": "boolean", "default": false},
          "bindings": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["role", "from_stage", "selector"],
              "properties": {
                "role": {"const": "checkpoint"},
                "from_stage": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
                "selector": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path"],
                  "properties": {
                    "path": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/"}
                  }
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {"properties": {"kind": {"const": "test"}}, "required": ["kind"]},
            "then": {
              "required": ["requires_approval"],
              "properties": {"requires_approval": {"const": true}}
            }
          }
        ]
      }
    }
  }
}
