{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cross-computer-ssh.local/schemas/worker-pool.schema.json",
  "title": "CCS Worker Pool v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workers"],
  "properties": {
    "schema_version": {"const": 1},
    "workers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "host"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
          "host": {"type": "string", "minLength": 1},
          "user": {"type": "string"},
          "port": {"type": "integer", "minimum": 1, "maximum": 65535},
          "remote_root": {"type": "string"},
          "trainctl_executable": {"type": "string"},
          "known_hosts": {"type": "string"},
          "identity_file": {"type": "string"},
          "enabled": {"type": "boolean"},
          "disabled_reason": {"type": "string", "minLength": 1, "maxLength": 500},
          "labels": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"}
          },
          "workspace_user": {"type": "string"},
          "workspace_root": {"type": "string"},
          "workspace_executable": {"type": "string"}
        }
      }
    }
  }
}
