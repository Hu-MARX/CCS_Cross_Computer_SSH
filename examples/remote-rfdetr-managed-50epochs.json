{
  "schema_version": 1,
  "name": "rfdetr-single-view-managed-50epochs",
  "project": {"path": "/srv/research/rf-detr"},
  "runtime": {
    "workdir": "/srv/research/rf-detr",
    "environment_variables": {
      "PYTHONDONTWRITEBYTECODE": "1",
      "PYTHONPATH": "/home/ubuntu/.ml-orchestrator/app/src",
      "PATH": "/home/ubuntu/anaconda3/envs/RFDETR/bin:/usr/local/bin:/usr/bin:/bin",
      "HF_HUB_OFFLINE": "1",
      "WANDB_MODE": "disabled",
      "CUBLAS_WORKSPACE_CONFIG": ":4096:8",
      "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True"
    }
  },
  "command": {
    "argv": [
      "/home/ubuntu/anaconda3/envs/RFDETR/bin/python", "-u",
      "/home/ubuntu/.ml-orchestrator/app/examples/rfdetr_managed.py",
      "--epochs", "50", "--batch-size", "2", "--grad-accum", "4",
      "--num-workers", "0", "--checkpoint-steps", "1000",
      "--checkpoint-seconds", "1800", "--checkpoint-keep", "3"
    ]
  },
  "resources": {"gpu_index": 0},
  "outputs": {"checkpoint_glob": "orchestrator_runs/${RUN_ID}/checkpoints/*.ckpt"},
  "automation": {"max_attempts": 1, "allowed_actions": ["wait", "complete"]},
  "task": {"kind": "train", "inputs": []}
}
